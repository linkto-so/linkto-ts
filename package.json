{
  "name": "@linkto-so/sdk",
  "version": "0.1.0",
  "description": "SDK for linkto-so",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "homepage": "https://linkto.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linkto-so/linkto-ts.git"
  },
  "bugs": {
    "url": "https://github.com/linkto-so/linkto-ts/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
